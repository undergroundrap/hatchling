# Hatchling's broker configuration: the whole of it, read by
# hatchling.service at each start. scripts/install.sh writes it as
# /etc/hatchling/hatchling.env, filling in the @...@ values; edit it, then
# `sudo systemctl restart hatchling`. Every setting is described by
# `hatchling-broker --help`.

# Who the app, the API and the Machine view answer: the user who installed
# Hatchling. Nobody else on the machine is let in.
HATCHLING_OWNER_UID=@OWNER_UID@

# The cells: each runs as hatchling-cell, and connects to the broker over a
# connection of its own.
HATCHLING_AGENT_UID=hatchling-cell
HATCHLING_AGENT_BIN=/usr/local/bin/hatchling-agent
HATCHLING_CELL_ID=cell-01

# Where it keeps its state, and its sockets.
HATCHLING_BROKER_SOCKET=/var/lib/hatchling/sock/broker.sock
HATCHLING_VAULT_DIR=/var/lib/hatchling/vault
HATCHLING_SCHEDULER_DIR=/var/lib/hatchling/schedules
HATCHLING_CONVERSATION_DIR=/var/lib/hatchling/conversation
HATCHLING_MEMORY_DIR=/var/lib/hatchling/memory
HATCHLING_GOALS_DIR=/var/lib/hatchling/goals
HATCHLING_CHANNEL_INGRESS=/var/lib/hatchling/ingress.sock
HATCHLING_API_SOCKET=/var/lib/hatchling/api.sock
HATCHLING_UI_SOCKET=/var/lib/hatchling/ui.sock
HATCHLING_OPERATOR_SOCKET=/var/lib/hatchling/operator.sock

# The model: an OpenAI-compatible endpoint on this machine (Ollama,
# llama.cpp, LM Studio, vLLM), the one place a cell may reach. For a hosted
# API, see docs/hosted-models.md.
HATCHLING_SCHEDULER_MODEL_ENDPOINT=@MODEL_ENDPOINT@
HATCHLING_SCHEDULER_MODEL_NAME=@MODEL_NAME@
HATCHLING_EGRESS_ALLOWLIST=local-keyless:@MODEL_HOSTPORT@
HATCHLING_EGRESS_GRANTS=@MODEL_HOSTPORT@

# What the agent may keep for you: what it learns about you (your memory),
# and your goals and what it tracks for them. A chat holds the grants the
# app holds (HATCHLING_API_GRANTS), so it may do the same.
HATCHLING_MEMORY_GRANTS=user:write,user:recall,user:remove
HATCHLING_GOALS_GRANTS=goal-create,goal-update,goal-close,tracking-append,query-goals,query-tracking
HATCHLING_API_GRANTS=egress:@MODEL_HOSTPORT@,channel-send:local,memory:user:write,memory:user:recall,memory:user:remove,goals:goal-create,goals:goal-update,goals:goal-close,goals:tracking-append,goals:query-goals,goals:query-tracking
